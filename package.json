{
  "name": "ateco-codes-api",
  "version": "1.0.0",
  "description": "ATECO 2025 Codes API with Profitability Coefficients - Deployed on GitHub Pages",
  "main": "api.js",
  "scripts": {
    "build": "node build.js",
    "dev": "node api.js",
    "start": "node api.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "keywords": ["ateco", "api", "italy", "business", "profitability", "github-pages"],
  "author": "ATECO API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FeliceC/ateco-codes.git"
  },
  "homepage": "https://FeliceC.github.io/ateco-codes",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "api.js",
      "build.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}