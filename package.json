{
  "name": "ateco-codes-api",
  "version": "2.0.1",
  "description": "ATECO 2025 Codes API with Profitability Coefficients - Deployed on GitHub Pages",
  "main": "api.js",
  "scripts": {
    "build": "node build.js",
    "generate": "node generate-data.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "keywords": ["ateco", "api", "italy", "business", "profitability", "github-pages"],
  "author": "Felice Caricati",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FeliceC/ateco_codes.git"
  },
  "homepage": "https://FeliceC.github.io/ateco_codes",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "api.js",
      "build.js",
      "generate-data.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}